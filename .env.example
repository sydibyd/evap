# Copy to .env and replace every CHANGE_ME value. Never commit .env.
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=CHANGE_ME
EVAP_JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS
EVAP_RUNNER_TOKEN=CHANGE_ME
# First-start admin account (only used while the users table is empty).
EVAP_BOOTSTRAP_ADMIN_USER=admin
EVAP_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_MIN_10_CHARS
# Host integration
EVAP_HTTP_PORT=8300
DOCKER_GID=137            # stat -c %g /var/run/docker.sock
RUNNER_UID=1000           # id -u   (owner of the deploy key file)
# Read-only SSH deploy key for a private SUT repository (empty file = public HTTPS repos only).
GIT_DEPLOY_KEY_FILE=./secrets/git_deploy_key
# Sandbox limits per test execution
SANDBOX_MEMORY=256m
SANDBOX_CPUS=1.0
